#!/bin/bash
# Pre-commit hook enforcing VERSION.md workflow
set -euo pipefail
if [ "${SKIP_CHECKS:-0}" = "1" ]; then exit 0; fi

CHANGESETS_DIR=".changeset"

# Detect changes that require a changeset
STAGED_FILES=$(git diff --cached --name-only)

# Files that trigger changeset requirement
CODE_PATTERNS=('\.rs$' 'Cargo\.toml' 'Cargo\.lock' '^crates/')
needs_changeset=0
for file in $STAGED_FILES; do
    for pattern in "${CODE_PATTERNS[@]}"; do
        if [[ "$file" =~ $pattern ]]; then
            needs_changeset=1
            break
        fi
    done
    if [ "$needs_changeset" = "1" ]; then
        break
    fi
done

# Run pre-commit checks on any code change
if [ "$needs_changeset" = "1" ]; then
    echo "[CHECK] Running pre-commit checks..."
    echo ""

    echo "  cargo fmt --check"
    cargo fmt --all -- --check 2>/dev/null || { echo "[FAIL] Formatting check failed. Run: cargo fmt --all"; exit 1; }

    echo "  cargo clippy"
    cargo clippy --workspace --all-targets --all-features -- -D warnings 2>/dev/null || { echo "[FAIL] Clippy failed"; exit 1; }

    echo "  cargo build"
    cargo build --workspace 2>/dev/null || { echo "[FAIL] Build failed"; exit 1; }

    echo "  cargo test (unit + integration)"
    cargo test --workspace --lib --test integration --test cli_tests 2>/dev/null || { echo "[FAIL] Tests failed"; exit 1; }

    echo "  cargo test (e2e)"
    cargo test --test e2e -- --test-threads=1 2>/dev/null || { echo "[FAIL] E2E tests failed"; exit 1; }

    echo ""
    echo "[PASS] All pre-commit checks passed"
fi

# Allow version-bump commits (Cargo.toml + CHANGELOG.md only, no .rs changes)
rs_changes=$(echo "$STAGED_FILES" | grep -c '\.rs$' || true)
cargo_toml_changes=$(echo "$STAGED_FILES" | grep -c 'Cargo\.toml' || true)
changelog_changes=$(echo "$STAGED_FILES" | grep -c 'CHANGELOG\.md' || true)
if [ "$rs_changes" = "0" ] && [ "$cargo_toml_changes" -ge "1" ] && [ "$changelog_changes" -ge "1" ]; then
    exit 0
fi

# Check for changesets
if [ "$needs_changeset" = "1" ]; then
    has_changeset=0
    if ls "$CHANGESETS_DIR"/*.md >/dev/null 2>&1; then
        has_changeset=1
    fi

    if [ "$has_changeset" = "0" ]; then
        echo ""
        echo "[FAIL] Commit contains code changes but no changeset found in .changeset/"
        echo ""
        echo "Follow the VERSION.md workflow:"
        echo ""
        echo "  1. Create a changeset:"
        echo "     bash scripts/create-changeset.sh"
        echo "     OR manually create .changeset/<name>.md"
        echo ""
        echo "  2. Run consume script:"
        echo "     bash scripts/consume-changesets.sh"
        echo ""
        echo "  3. Stage and commit:"
        echo "     git add -A"
        echo "     git commit ..."
        echo ""
        exit 1
    fi
fi

exit 0
